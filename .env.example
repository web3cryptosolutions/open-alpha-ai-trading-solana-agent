# ──────────────────────────────────────────────────────────────
# Open Alpha — environment configuration
# Copy this file to `.env` and fill in what you need.
# The default mock setup runs with ZERO keys and ZERO funds.
# ──────────────────────────────────────────────────────────────

# ── Runtime mode ────────────────────────────────────────────────
# mock     -> deterministic mock data, paper execution (no keys, no funds) [DEFAULT]
# live-read -> real read-only data feeds, paper execution (needs data keys)
# live      -> real data + real swaps (needs a funded keypair; advanced)
OPENALPHA_MODE=mock

# ── AI decision engine ──────────────────────────────────────────
# engine: rules | claude
DECISION_ENGINE=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Solana ───────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Path to a JSON keypair file. ONLY used when OPENALPHA_MODE=live.
# Leave empty for mock/paper trading. Never commit this file.
SOLANA_KEYPAIR_PATH=

# ── Data providers (only needed for live-read / live) ───────────
HELIUS_API_KEY=
BIRDEYE_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# ── Bots (optional) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# ── Storage ──────────────────────────────────────────────────────
# Directory for the local memory store (trades, outcomes, patterns).
OPENALPHA_DATA_DIR=./data

# ── Risk guardrails (hard caps the agent cannot exceed) ─────────
MAX_POSITION_SOL=0.5
MAX_OPEN_POSITIONS=5
MIN_RISK_SCORE_TO_TRADE=60
DAILY_LOSS_LIMIT_SOL=2
