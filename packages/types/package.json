{
  "name": "@openalpha/types",
  "version": "0.1.0",
  "description": "Shared type contracts for the Open Alpha trading OS. Every package speaks these types.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  }
}
